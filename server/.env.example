# MongoDB Atlas connection string. Get one free at https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/chess?retryWrites=true&w=majority

# Optional: database name (default: "chess")
MONGODB_DB=chess

# --- Stripe ---
# Secret key from https://dashboard.stripe.com/apikeys (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_...

# Price ID for the $4.99/month subscription product created in Stripe Dashboard
# Dashboard → Products → your product → price ID (starts with price_)
STRIPE_PRICE_ID=price_...

# Webhook signing secret — from Dashboard → Webhooks → your endpoint → Signing secret
# Also returned by `stripe listen --print-secret` when using the Stripe CLI locally
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the frontend (used for Stripe redirect URLs)
# In development this is the Vite dev server; in production set to your deployed domain
FRONTEND_URL=http://localhost:5173
